        {
          "text": "%)"
        }
      ],
      "options": [
        {
          "text": {
            "text": "방송 끄기",
            "color": "#F28B82"
          },
          "target": "end",
          "command": [
            "stream menu_toggle"
          ],
          "visibility_command": "execute if score @s tv_m_on matches 1"
        },
        {
          "text": {
            "text": "방송 켜기",
            "color": "#7EE0A1"
          },
          "target": "end",
          "command": [
            "stream menu_toggle"
          ],
          "visibility_command": "execute if score @s tv_m_on matches 0"
        },
        {
          "text": {
            "text": "정산하기",
            "color": "#FFD54F"
          },
          "target": "end",
          "command": [
            "stream menu_settle"
          ],
          "visibility_command": "execute if score @s tv_m_pending matches 1.."
        },
        {
          "text": {
            "text": "방송 채팅창 끄기"
