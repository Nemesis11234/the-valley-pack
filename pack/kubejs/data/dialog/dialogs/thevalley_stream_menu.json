          "command": [
            "stream menu_chat"
          ],
          "visibility_command": "execute if score @s tv_m_chat matches 1"
        },
        {
          "text": {
            "text": "방송 채팅창 켜기"
          },
          "target": "end",
          "command": [
            "stream menu_chat"
          ],
          "visibility_command": "execute if score @s tv_m_chat matches 0"
