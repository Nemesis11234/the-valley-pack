	quests: [
		{
			description: [
				"Butchery turns animals and unusual creatures into materials for cooking and crafting. Begin with its tools, then build a small processing corner beside your kitchen."
				""
				"SVE gives the &6Mincer&r and &6Meat Grinder&r different jobs. The following branches will help you choose the right machine."
			]
			icon: {
				Count: 1
				id: "butchery:iron_cleaver"
				tag: {
					Damage: 0
				}
			}
