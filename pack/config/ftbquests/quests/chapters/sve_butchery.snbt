			subtitle: "A useful kitchen starts before the cooking pot."
			tasks: [{
				id: "74218C45AABC6FA2"
				title: "Read and understood."
				type: "checkmark"
			}]
			title: "From Field to Feast"
			x: 0.0d
			y: 0.0d
		}
		{
			dependencies: ["1DE94091C3F46316"]
			description: [
				"Obtain an Iron Cleaver and a Hook for your butchery workspace. Use the cleaver when hunting suitable animals for carcasses, and consult the available processing recipes for your catch."
				""
				"These item tasks inspect your inventory; you keep your tools."
			]
			icon: "butchery:hook"
