{
  "name": "the-valley-launcher",
  "productName": "The Valley",
  "version": "1.0.0",
  "description": "The Valley 서버 전용 런처",
  "main": "src/main.js",
  "author": "Nemesis11234",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.nemesis11234.thevalley",
    "productName": "The Valley",
    "artifactName": "TheValley-Setup.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Valley",
      "installerLanguages": ["ko_KR"],
      "language": "1042"
    }
  }
}
